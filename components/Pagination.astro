---
// Previous/next follow the reading order of the page's own tab
// (components/sections.ts), so the Reference and Agents tabs page through
// their own sections instead of Blume's prefix-scoped tree.
import Pagination from "blume/components/layout/Pagination.astro";
import { flattenPages, getPagination } from "blume/components/layout/nav-utils.ts";
import { stripBasePath } from "blume/core/base-path.ts";
import data from "blume:data";

import { sectionSidebar } from "./sections.ts";

const { strings } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/u, "");
const route = stripBasePath(base, Astro.url.pathname.replace(/(.)\/$/u, "$1"));
const { sidebar, tabs, root } = data.navigation;
const { prev, next } = getPagination(flattenPages(sectionSidebar(sidebar, tabs, route, root)), route);
---

<Pagination next={next} prev={prev} strings={strings} />
