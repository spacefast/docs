<div class="config-playground" data-config-playground>
  <form class="config-controls">
    <div class="config-control">
      <label for="config-name">Space name</label>
      <input id="config-name" name="name" placeholder="Acme Docs" type="text" />
    </div>

    <div class="config-control">
      <label for="config-mode">Serving mode</label>
      <select id="config-mode" name="mode">
        <option value="website">Website</option>
        <option value="files">Files</option>
      </select>
    </div>

    <label class="config-toggle">
      <span>
        <strong>Single-page app</strong>
        <small>Serve <code>index.html</code> when no published path matches.</small>
      </span>
      <input name="spa" type="checkbox" />
    </label>

    <label class="config-toggle">
      <span>
        <strong>Clean URLs</strong>
        <small>Serve <code>/about.html</code> at <code>/about</code>.</small>
      </span>
      <input checked name="cleanUrls" type="checkbox" />
    </label>

    <label class="config-toggle">
      <span>
        <strong>Public space</strong>
        <small>Create a public Grant for every path.</small>
      </span>
      <input name="public" type="checkbox" />
    </label>

    <div class="config-control">
      <label for="config-title">Page title</label>
      <input id="config-title" name="title" placeholder="Acme Docs" type="text" />
    </div>

    <div class="config-control">
      <label for="config-description">Description</label>
      <input
        id="config-description"
        name="description"
        placeholder="Everything Acme."
        type="text"
      />
    </div>
  </form>

  <section class="config-output" aria-live="polite">
    <div class="config-output-header">
      <span>sf.jsonc</span>
      <button data-config-copy type="button">Copy</button>
    </div>
    <pre><code data-config-code></code></pre>
  </section>
</div>

<script>
  const playgrounds = document.querySelectorAll<HTMLElement>("[data-config-playground]");

  for (const playground of playgrounds) {
    const form = playground.querySelector<HTMLFormElement>("form");
    const code = playground.querySelector<HTMLElement>("[data-config-code]");
    const copy = playground.querySelector<HTMLButtonElement>("[data-config-copy]");
    if (!form || !code || !copy) continue;

    const mode = form.elements.namedItem("mode");
    const spa = form.elements.namedItem("spa");

    const render = () => {
      const filesMode = mode instanceof HTMLSelectElement && mode.value === "files";
      if (spa instanceof HTMLInputElement) {
        spa.disabled = filesMode;
        if (filesMode) spa.checked = false;
      }

      const values = new FormData(form);
      const config: Record<string, unknown> = {
        $schema: "https://spacefast.com/schemas/sf.json",
      };
      const name = String(values.get("name") ?? "").trim();
      const title = String(values.get("title") ?? "").trim();
      const description = String(values.get("description") ?? "").trim();
      if (name) config.name = name;
      if (filesMode) {
        config.index = false;
        config.listing = true;
      }
      if (!filesMode && values.get("spa") === "on") config.fallback = "/index.html";
      config.cleanUrls = values.get("cleanUrls") === "on";
      if (values.get("public") === "on") config.access = "public";
      if (title || description) {
        config.meta = {
          ...(title ? { title } : {}),
          ...(description ? { description } : {}),
        };
      }
      code.textContent = JSON.stringify(config, null, 2);
    };

    form.addEventListener("input", render);
    form.addEventListener("change", render);
    copy.addEventListener("click", async () => {
      await navigator.clipboard.writeText(code.textContent ?? "");
      copy.textContent = "Copied";
      window.setTimeout(() => {
        copy.textContent = "Copy";
      }, 1200);
    });
    render();
  }
</script>

<style>
  .config-playground {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 1rem;
    margin: 1.5rem 0 2rem;
  }

  .config-controls,
  .config-output {
    min-width: 0;
    margin: 0;
    border: 1px solid var(--blume-border);
    border-radius: 0.75rem;
    background: var(--blume-card);
  }

  .config-controls {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1rem;
  }

  .config-control {
    display: grid;
    gap: 0.35rem;
  }

  .config-control label,
  .config-toggle strong {
    color: var(--blume-foreground);
    font-size: 0.82rem;
    font-weight: 650;
  }

  .config-control input,
  .config-control select {
    width: 100%;
    min-height: 2.5rem;
    border: 1px solid var(--blume-border);
    border-radius: 0.5rem;
    background: var(--blume-background);
    color: var(--blume-foreground);
    padding: 0.55rem 0.7rem;
    font: inherit;
  }

  .config-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    cursor: pointer;
  }

  .config-toggle span {
    display: grid;
    gap: 0.15rem;
  }

  .config-toggle small {
    color: var(--blume-muted-foreground);
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .config-toggle input {
    width: 1.15rem;
    height: 1.15rem;
    accent-color: var(--blume-accent);
  }

  .config-toggle:has(input:disabled) {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .config-output {
    overflow: hidden;
    background: var(--blume-code-background);
  }

  .config-output-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--blume-border);
    padding: 0.65rem 0.85rem;
    color: var(--blume-muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .config-output-header button {
    border: 1px solid var(--blume-border);
    border-radius: 999px;
    background: var(--blume-background);
    color: var(--blume-foreground);
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    font: inherit;
  }

  .config-output pre {
    min-height: 100%;
    margin: 0;
    border: 0;
    border-radius: 0;
    padding: 1rem;
    background: transparent;
    overflow: auto;
  }

  .config-output code {
    white-space: pre;
  }

  @media (max-width: 48rem) {
    .config-playground {
      grid-template-columns: minmax(0, 1fr);
    }

    .config-output pre {
      max-height: 28rem;
    }
  }
</style>
