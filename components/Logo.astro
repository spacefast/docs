---
// The brand lockup: the Spacefast mark links to the Website home, "Docs" links
// to the Docs home. Docs are always served inside the Website artifact at
// /docs, so the configured root-relative `logo.href` ("/") is emitted as is,
// without the deployment base, and reaches the Website home on whatever origin
// serves the page.
import { withBase } from "blume/components/islands/base-path.ts";
import type { BlumeLogo } from "blume/core/data.ts";

interface Props {
  site: { title: string };
  logo?: BlumeLogo | null;
  locale?: string;
}

const { site, logo } = Astro.props;
const label = logo?.text ?? site.title;
const link = "inline-flex items-center transition-opacity hover:opacity-80";
---

<div class="flex min-w-0 items-center gap-2" data-sf-brand>
  {
    logo?.svg && (
      <a aria-label={`${logo.alt || "Spacefast"} home`} class:list={[link, "shrink-0 text-foreground"]} href={logo.href}>
        <span aria-hidden="true" class="inline-flex h-5 items-center [&>svg]:h-5 [&>svg]:w-auto" set:html={logo.svg} />
      </a>
    )
  }
  {
    label && (
      <a class:list={[link, "min-w-0 font-semibold text-base text-foreground"]} href={withBase("/")}>
        <span class="truncate">{label}</span>
      </a>
    )
  }
</div>
