---
/*
 * Blume's sidebar, scoped to this site's five tabs (components/sections.ts).
 * Blume scopes by URL prefix, which cannot express the Reference tab (it spans
 * /cli, /api, /config-file, and other root pages) or the Agents tab's generated
 * /setup and /connect pages, so this recomputes the tab's tree from the full
 * navigation.
 */
import NavTree from "blume/components/layout/NavTree.astro";
import type { NavNode } from "blume/core/types.ts";
import data from "blume:data";

import { sectionSidebar } from "./sections.ts";

type Props = Record<string, unknown> & { items: NavNode[]; currentRoute: string };

const { items: _scoped, ...rest } = Astro.props as Props;
const { sidebar, tabs, root } = data.navigation;
const items = sectionSidebar(sidebar, tabs, rest.currentRoute, root);
---

<NavTree {...rest} items={items} />
