---
/*
 * One pricing table for the draft Pricing & Limits page. It reads the plan
 * data straight from scripts/pricing-next.mjs, so every number has one source.
 * Row explanations open from a small "i" next to the row name (hover, focus or
 * tap); labels such as Beta sit on the row name, and the price lives in the cell.
 */
import { pricingTable } from "../scripts/pricing-next.mjs";

interface Props {
  table: "plans" | "team" | "space" | "features" | "examples" | "payments";
}

const { table } = Astro.props;
const { columns, groups, highlight } = pricingTable(table);
const span = columns.length + 1;
---

<div class="sf-pricing not-prose" data-pricing-table={table}>
  <table>
    <thead>
      <tr>
        <th scope="col"><span class="sf-visually-hidden">Item</span></th>
        {columns.map((column) => (
          <th scope="col" class:list={[{ "sf-highlight": column.name === highlight }]}>
            {column.name}
            {column.tag && <span class:list={["sf-tag", `sf-tag-${column.tag}`]}>{column.tag === "soon" ? "Soon" : column.tag}</span>}
            {column.note && <small>{column.note}</small>}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {groups.map(([group, rows]) => (
        <>
          {group && (
            <tr class="sf-group">
              <th scope="rowgroup" colspan={span}>{group}</th>
            </tr>
          )}
          {rows.map((row) => (
            <tr>
              <th scope="row">
                <span class="sf-label">{row.label}</span>
                {row.tag && <span class:list={["sf-tag", `sf-tag-${row.tag}`]}>{{ beta: "Beta", soon: "Soon", comp: "Complimentary" }[row.tag]}</span>}
                {row.tip && (
                  <span class="sf-tip" tabindex="0" role="note" aria-label={row.tip}>
                    <span class="sf-tip-mark" aria-hidden="true">i</span>
                    <span class="sf-tip-body" aria-hidden="true">{row.tip}</span>
                  </span>
                )}
              </th>
              {row.values.map((value, index) => (
                <td class:list={[{ "sf-highlight": columns[index]?.name === highlight, "sf-none": value === "—" }]} data-label={columns[index]?.name}>
                  {value === "✓" ? <span class="sf-yes" aria-label="Included">✓</span> : value === "—" ? <span aria-label="Not included">—</span> : value}
                </td>
              ))}
            </tr>
          ))}
        </>
      ))}
    </tbody>
  </table>
</div>

<style>
  .sf-pricing {
    margin: 1rem 0 2rem;
    overflow-x: auto;
    border: 1px solid var(--blume-border);
    border-radius: var(--blume-radius, 0.5rem);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: 0.55rem 0.75rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--blume-border);
  }
  thead th {
    position: sticky;
    top: 0;
    background: var(--blume-background);
    font-weight: 500;
    white-space: nowrap;
  }
  thead small {
    display: block;
    color: var(--blume-muted-foreground);
    font-weight: 400;
    white-space: normal;
  }
  tbody th[scope="row"] {
    font-weight: 500;
    min-width: 11rem;
  }
  td {
    min-width: 7rem;
  }
  @media (max-width: 640px) {
    tbody th[scope="row"],
    thead th:first-child {
      position: sticky;
      left: 0;
      z-index: 1;
      min-width: 8.5rem;
      max-width: 8.5rem;
      background: var(--blume-background);
    }
    thead th:first-child {
      z-index: 3;
    }
    tr.sf-group th {
      position: static;
    }
  }
  tr.sf-group th {
    padding-top: 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--blume-muted-foreground);
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  td {
    color: var(--blume-foreground);
  }
  .sf-none {
    color: var(--blume-muted-foreground);
  }
  .sf-yes {
    font-weight: 600;
  }
  .sf-highlight {
    background: var(--blume-muted);
  }
  .sf-tag {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.35rem;
    vertical-align: 1px;
    background: var(--blume-muted);
    color: var(--blume-muted-foreground);
    text-transform: none;
    letter-spacing: 0;
  }
  .sf-tag-beta {
    color: #a16207;
    background: color-mix(in oklch, #eab308 16%, transparent);
  }
  .sf-tag-comp {
    color: #15803d;
    background: color-mix(in oklch, #22c55e 16%, transparent);
  }
  :global(:root[data-theme="dark"]) .sf-tag-beta {
    color: #facc15;
  }
  :global(:root[data-theme="dark"]) .sf-tag-comp {
    color: #4ade80;
  }
  .sf-tip {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 1rem;
    height: 1rem;
    margin-left: 0.35rem;
    border: 1px solid var(--blume-border);
    border-radius: 999px;
    color: var(--blume-muted-foreground);
    font-size: 0.625rem;
    line-height: 1;
    cursor: help;
    vertical-align: 1px;
  }
  .sf-tip-mark {
    font: italic 600 0.625rem/1 Georgia, serif;
  }
  .sf-tip:hover,
  .sf-tip:focus-visible {
    color: var(--blume-foreground);
    border-color: var(--blume-foreground);
    outline: none;
  }
  .sf-tip-body {
    display: none;
    position: absolute;
    left: 0;
    top: calc(100% + 0.4rem);
    z-index: 20;
    width: max-content;
    max-width: min(18rem, 70vw);
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--blume-border);
    border-radius: 0.375rem;
    background: var(--blume-background);
    color: var(--blume-foreground);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.45;
    font-style: normal;
    white-space: normal;
    text-transform: none;
    letter-spacing: 0;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.18);
  }
  .sf-tip:hover .sf-tip-body,
  .sf-tip:focus .sf-tip-body {
    display: block;
  }
  .sf-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
</style>
