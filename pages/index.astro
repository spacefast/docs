---
import { getEntry, render } from "astro:content";
import type { CollectionKey } from "astro:content";

import Card from "blume/components/content/Card.astro";
import CardGroup from "blume/components/content/CardGroup.astro";
import RootLayout from "blume/components/layout/RootLayout.astro";
import data from "blume:data";

export const prerender = true;

const page = data.routes.find((route) => route.path === "/");
if (!page) throw new Error("Missing developer portal overview route.");

const entry = await getEntry(page.collection as CollectionKey, page.entryId);
if (!entry) throw new Error("Missing developer portal overview content.");

const { Content, headings } = await render(entry);
const frontmatter = entry.data ?? {};
const seo = frontmatter.seo ?? {};
const site = data.config.site?.replace(/\/$/, "") ?? null;
const ogPath = data.config.og.enabled ? "/og/index.png" : null;
const ogImage = seo.image ?? (ogPath && site ? `${site}${ogPath}` : ogPath);
---

<RootLayout
  site={{ title: data.config.title, description: data.config.description }}
  layout={{}}
  clientData={{
    config: data.config,
    navigation: data.navigation,
    page: { route: "/", title: seo.title ?? page.title },
  }}
  logo={data.config.logo}
  mcp={data.config.mcp}
  favicon={data.config.favicon}
  appleIcon={data.config.appleIcon}
  banner={data.config.banner}
  analytics={data.config.analytics}
  imageZoom={data.config.imageZoom}
  codeWrap={data.config.codeWrap}
  navigation={data.navigation}
  locale="en"
  dir="ltr"
  contentDir="ltr"
  ui={data.ui}
  localeAlternates={[]}
  xDefault={null}
  localeSwitch={[]}
  page={{
    title: seo.title ?? page.title,
    description: seo.description ?? frontmatter.description,
    route: "/",
  }}
  headings={headings}
  toc={data.config.toc}
  dateFormat={data.config.dateFormat}
  themeMode={data.config.theme.mode}
  fontCssVars={data.fontCssVars}
  searchEnabled={data.config.search.enabled}
  indexable={page.indexable}
  ogImage={ogImage}
  ogGenerated={!seo.image && Boolean(ogPath)}
  x={data.config.x}
  canonical={seo.canonical ?? site}
  editUrl={page.editUrl}
  feedback={data.config.feedback}
  exportPdf={true}
  exportEpub={true}
  feeds={data.feeds}
  siteUrl={data.config.site}
  pageType={frontmatter.type}
  published={frontmatter.date ?? frontmatter.changelog?.date ?? null}
  lastModified={page.lastModified}
  noindex={seo.noindex}
  structuredDataEnabled={data.config.structuredData}
>
  <h1>{page.title}</h1>
  {
    frontmatter.description && (
      <p class="text-lg text-muted-foreground">{frontmatter.description}</p>
    )
  }
  <Content components={{ Card, CardGroup }} />
</RootLayout>
