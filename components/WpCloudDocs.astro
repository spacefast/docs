---
import { contentHref } from "blume/components/content/base-href.ts";

interface Props {
  title: string;
  href: string;
}

const { title, href } = Astro.props;
---

<aside class="not-prose mt-10 border-border border-t pt-4 text-muted-foreground text-sm leading-6 [&_a]:underline [&_a]:decoration-current/50 hover:[&_a]:text-foreground" data-wp-cloud-docs>
  <p>
    Spacefast is built on Automattic's <a href="https://wp.cloud/">WP Cloud</a>. Using the <a href={contentHref("/platforms/partner-api")}>Partner API</a>? See <a href={href}>{title}</a> on WP Cloud Docs.
  </p>
</aside>
